#include <iostream>
using namespace std;
int main() { setlocale(LC_ALL, "Russian");
int n, m;

cout << "Введите количество тарифных планов n (2..6): ";
cin >> n;
cout << "Введите число месяцев m (2..8): ";
cin >> m;

// Проверка диапазонов
if (n < 2 || n > 6 || m < 2 || m > 8) {
    cout << "Ошибка ввода" << endl;
    return 0;
}

cout << "\nТаблица накопленных выплат:" << endl;

// Обязательно вложенные циклы
for (int i = 1; i <= n; i++) {
    double rowAccumulator = 0; // Накопитель для каждой строки
    cout << "План " << i << ": ";

    for (int j = 1; j <= m; j++) {
        double monthlyFee = 10 + 5 * i; // Ежемесячная плата
        double currentMonthTotal = monthlyFee;

        // Каждый третий месяц доп. списание 7
        if (j % 3 == 0) {
            currentMonthTotal += 7;
        }

        rowAccumulator += currentMonthTotal;
        
        // Выводим сумму с начала обслуживания по месяц j
        cout << rowAccumulator << "\t"; 
    }
    cout << endl; // Переход на новую строку для следующего плана
}

return 0;
}
